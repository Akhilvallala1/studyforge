# LLM provider: "anthropic" (default), "ollama", or "fake" (deterministic offline provider for QA/tests; no API key needed)
STUDYFORGE_LLM_PROVIDER=anthropic

# Anthropic - leave unset to use ANTHROPIC_API_KEY from your environment
# or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
STUDYFORGE_MODEL=claude-opus-5

# Ollama (only if STUDYFORGE_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Context window in tokens. This matters more than it looks: Ollama's own default
# is 4096, and it does not error when a prompt overruns the window, it just drops
# the overflow and answers from what is left. A course generated that way reads
# fine and ignores most of your document.
#
# 8192 holds a lesson call (up to two 8,000-char source segments plus room for the
# lesson it writes back) and an outline for a document of about three chunks. It
# also fits a 7-8B model at Q4 in 6GB of VRAM: the KV cache costs about 1GB at this
# size, and doubling it spills the model onto the CPU. Raise it if you have the
# VRAM and feed it long documents; StudyForge logs a warning when a prompt looks
# too big for the window, and fails the call outright when Ollama reports having
# filled it, rather than handing you a course built from a fragment.
#
# Long documents on a 6GB card: split them, do not raise this.
# The outline call always sends the whole document. On top of that, a document of
# four or more chunks asks the model to route each lesson to the segments it needs,
# and a small local model that cannot manage that field falls back to sending the
# whole document with EVERY lesson call (app/generation.py, lesson_segments). So on
# an ordinary 50-page PDF the realistic outcome is a failed generation telling you
# to raise OLLAMA_NUM_CTX, which is the one thing 6GB of VRAM will not let you do.
# Feed it a chapter at a time instead. That is a real limit of the hardware, not a
# setting to tune around, and a failed generation is the honest form of it.
OLLAMA_NUM_CTX=8192

# SQLite database path
STUDYFORGE_DB=studyforge.sqlite3

# Comma-separated origins allowed to call the API from a browser
STUDYFORGE_CORS_ORIGINS=http://localhost:3000

# Allow "generate from URL" to fetch private, loopback and link-local addresses.
# Off by default: the server fetches the URL on the caller's behalf, so leaving this
# open lets anyone who can reach the API read your local network back out as course
# material. Turn it on only if you deliberately ingest from a wiki or docs server on
# your own network, and only if you trust everyone who can reach this API.
# STUDYFORGE_ALLOW_PRIVATE_URLS=true

# --- API cost tracking ---

# Optional hard spend cap in USD across all paid-provider (anthropic) LLM calls.
# When cumulative estimated spend reaches this value, further generate requests
# are rejected with HTTP 402 before the next LLM call runs. Unset means no cap.
# STUDYFORGE_COST_LIMIT_USD=25.00

# Cumulative spend threshold (USD) that triggers the recurring cost alert surfaced
# by GET /usage. Fires again every time spend crosses another multiple of this
# value, until acknowledged via POST /usage/alert/ack. Default: 10.
STUDYFORGE_COST_ALERT_USD=10

# Fallback per-million-token USD prices used only when a model id isn't in the
# built-in PRICING table (app/costs.py) and has no matching prefix - e.g. an
# unrecognized or newly released model. Marks the estimate as approximate.
STUDYFORGE_PRICE_DEFAULT_IN_USD=5.00
STUDYFORGE_PRICE_DEFAULT_OUT_USD=25.00
