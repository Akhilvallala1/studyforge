# LLM provider: "anthropic" (default), "ollama", or "fake" (deterministic offline provider for QA/tests; no API key needed)
STUDYFORGE_LLM_PROVIDER=anthropic

# Anthropic - leave unset to use ANTHROPIC_API_KEY from your environment
# or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
STUDYFORGE_MODEL=claude-opus-5

# Ollama (only if STUDYFORGE_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# SQLite database path
STUDYFORGE_DB=studyforge.sqlite3

# Comma-separated origins allowed to call the API from a browser
STUDYFORGE_CORS_ORIGINS=http://localhost:3000

# --- API cost tracking ---

# Optional hard spend cap in USD across all paid-provider (anthropic) LLM calls.
# When cumulative estimated spend reaches this value, further generate requests
# are rejected with HTTP 402 before the next LLM call runs. Unset means no cap.
# STUDYFORGE_COST_LIMIT_USD=25.00

# Cumulative spend threshold (USD) that triggers the recurring cost alert surfaced
# by GET /usage. Fires again every time spend crosses another multiple of this
# value, until acknowledged via POST /usage/alert/ack. Default: 10.
STUDYFORGE_COST_ALERT_USD=10

# Fallback per-million-token USD prices used only when a model id isn't in the
# built-in PRICING table (app/costs.py) and has no matching prefix - e.g. an
# unrecognized or newly released model. Marks the estimate as approximate.
STUDYFORGE_PRICE_DEFAULT_IN_USD=5.00
STUDYFORGE_PRICE_DEFAULT_OUT_USD=25.00
